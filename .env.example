# Copy to .env and adjust. Values below match docker-compose.yml defaults.

# Postgres connection string (SQLAlchemy URL).
DATABASE_URL=postgresql+psycopg://taskqueue:taskqueue@localhost:5432/taskqueue

# Redis connection string. Redis is only the wake-up channel; Postgres is the
# source of truth for job state.
REDIS_URL=redis://localhost:6379/0

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=3600

# "dev" or "prod". In prod the app refuses to start with the default JWT_SECRET.
ENVIRONMENT=dev

# Worker behaviour.
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_CONCURRENCY=1
DEFAULT_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=60.0
